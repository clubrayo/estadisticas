# Copie este archivo como .env.local y complete con los datos de su proyecto Supabase
# (Project Settings > API Keys). Use SOLO la clave "publishable" (o la "anon" heredada):
# es pública por diseño y la seguridad la aplican las políticas RLS.
# NUNCA ponga aquí la clave "secret" ni la "service_role".
VITE_SUPABASE_URL=https://SU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
